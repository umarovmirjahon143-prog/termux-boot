import telebot

# BotFather’dan olgan tokeningizni shu yerga yozing
TOKEN = "8265642043:AAFNfGEtW7xhXP2EWw_GRZvLsaaPbEuA1_M"
bot = telebot.TeleBot(TOKEN)

# Kino kodlari va linklari ro'yxati
kino_links = {
    "99": "https://m.vk.com/video-229908696_456239942"
}

# /start komandasi
@bot.message_handler(commands=['start'])
def send_welcome(message):
    bot.reply_to(message, "👋 Salom! Kino kodini kiriting (masalan: 99)")

# Foydalanuvchi yozgan matnga javob
@bot.message_handler(func=lambda message: True)
def reply_message(message):
    text = message.text.strip()
    if text in kino_links:
        bot.reply_to(message, f"🎬 Mana kino: {kino_links[text]}")
    else:
        bot.reply_to(message, "❌ Bunday kod topilmadi. Masalan: 99 deb yozing.")

print("🤖 Bot ishga tushdi...")
bot.polling()
